# Скопируйте этот файл в .env и заполните. Файл .env в Git не попадает.

# Пароль для страницы /admin (логин: admin). Если пусто, админка выключена.
ADMIN_PASSWORD=придумайте-длинный-пароль

# Уведомления в Telegram (необязательно). Токен выдаёт @BotFather.
BOT_TOKEN=
CHAT_ID=

# Где лежит база SQLite
DB_PATH=data/leads.db

# Документация API на /docs (только для разработки)
ENABLE_DOCS=1
